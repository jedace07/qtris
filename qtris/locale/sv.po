#: qtris/runners/easyrpg.py:289 qtris/runners/scummvm.py:403
msgid "Soundfont"
msgstr "Soundfont"

#: qtris/runners/easyrpg.py:290
msgid "Soundfont in sf2 format to use when playing MIDI files."
msgstr "En Soundfont i sf2-format som används vid uppspelning av MIDI-filer."

#: qtris/runners/easyrpg.py:297
msgid "Start in fullscreen mode."
msgstr "Starta i helskärmsläge."

#: qtris/runners/easyrpg.py:305
msgid "Game resolution"
msgstr "Spelupplösning"

#: qtris/runners/easyrpg.py:307
msgid ""
"Force a different game resolution.\n"
"\n"
"This is experimental and can cause glitches or break games!"
msgstr ""
"Tvinga fram en annan spelupplösning.\n"
"\n"
"Detta är experimentellt och kan orsaka problem eller göra spel obrukbara!"

#: qtris/runners/easyrpg.py:310
msgid "320×240 (4:3, Original)"
msgstr "320×240 (4:3, original)"

#: qtris/runners/easyrpg.py:311
msgid "416×240 (16:9, Widescreen)"
msgstr "416×240 (16:9, bredbild)"

#: qtris/runners/easyrpg.py:312
msgid "560×240 (21:9, Ultrawide)"
msgstr "560×240 (21:9, ultrabred)"

#: qtris/runners/easyrpg.py:320
msgid "Scaling"
msgstr "Skalning"

#: qtris/runners/easyrpg.py:322
msgid ""
"How the video output is scaled.\n"
"\n"
"<b>Nearest</b>: Scale to screen size (causes scaling artifacts)\n"
"<b>Integer</b>: Scale to multiple of the game resolution\n"
"<b>Bilinear</b>: Like Nearest, but output is blurred to avoid artifacts\n"
msgstr ""
"Hur videoutmatningen skalas.\n"
"\n"
"<b>Närmast</b>: Skala till skärmstorlek (orsakar skalningsartefakter)\n"
"<b>Heltal</b>: Skala till en multipel av spelets upplösning\n"
"<b>Bilineär</b>: Som Närmast, men utmatningen är suddig för att undvika "
"artefakter\n"

#: qtris/runners/easyrpg.py:328
msgid "Nearest"
msgstr "Närmast"

#: qtris/runners/easyrpg.py:329
msgid "Integer"
msgstr "Heltal"

#: qtris/runners/easyrpg.py:330
msgid "Bilinear"
msgstr "Bilineär"

#: qtris/runners/easyrpg.py:338 qtris/runners/redream.py:30
#: qtris/runners/scummvm.py:229
msgid "Stretch"
msgstr "Sträck ut"

#: qtris/runners/easyrpg.py:339
msgid ""
"Ignore the aspect ratio and stretch video output to the entire width of the "
"screen."
msgstr ""
"Ignorera bildförhållandet och sträck ut videoutmatningen till hela skärmens "
"bredd."

#: qtris/runners/easyrpg.py:346
msgid "Enable VSync"
msgstr "Aktivera VSync"

#: qtris/runners/easyrpg.py:347
msgid "Switch off to disable VSync and use the FPS limit."
msgstr "Stäng av för att inaktivera VSync och använda FPS-begränsningen."

#: qtris/runners/easyrpg.py:354
msgid "FPS limit"
msgstr "FPS-begränsning"

#: qtris/runners/easyrpg.py:356
msgid ""
"Set a custom frames per second limit.\n"
"If unspecified, the default is 60 FPS.\n"
"Set to 0 to disable the frame limiter."
msgstr ""
"Ange en anpassad gräns för bilder per sekund.\n"
"Om inget anges är standardvärdet 60 FPS.\n"
"Ange 0 för att inaktivera bildbegränsningen."

#: qtris/runners/easyrpg.py:368 qtris/runners/wine.py:561
msgid "Show FPS"
msgstr "Visa FPS"

#: qtris/runners/easyrpg.py:369
msgid "Enable frames per second counter."
msgstr "Aktivera räknaren för bilder per sekund."

#: qtris/runners/easyrpg.py:372
msgid "Fullscreen & title bar"
msgstr "Helskärm och titelrad"

#: qtris/runners/easyrpg.py:373
msgid "Fullscreen, title bar & window"
msgstr "Helskärm, titelrad och fönster"

#: qtris/runners/easyrpg.py:380 qtris/runners/easyrpg.py:388
#: qtris/runners/easyrpg.py:395 qtris/runners/easyrpg.py:402
msgid "Runtime Package"
msgstr "Runtime Package"

#: qtris/runners/easyrpg.py:381
msgid "Enable RTP"
msgstr "Aktivera RTP"

#: qtris/runners/easyrpg.py:382
msgid "Switch off to disable support for the Runtime Package (RTP)."
msgstr "Stäng av för att inaktivera stödet för Runtime Package (RTP)."

#: qtris/runners/easyrpg.py:389
msgid "RPG2000 RTP location"
msgstr "Plats för RPG2000-RTP"

#: qtris/runners/easyrpg.py:390
msgid ""
"Full path to a directory containing an extracted RPG Maker 2000 Run-Time-"
"Package (RTP)."
msgstr ""
"Fullständig sökväg till en katalog som innehåller ett extraherat RPG Maker "
"2000 Run-Time-Package (RTP)."

#: qtris/runners/easyrpg.py:396
msgid "RPG2003 RTP location"
msgstr "Plats för RPG2003-RTP"

#: qtris/runners/easyrpg.py:397
msgid ""
"Full path to a directory containing an extracted RPG Maker 2003 Run-Time-"
"Package (RTP)."
msgstr ""
"Fullständig sökväg till en katalog som innehåller ett extraherat RPG Maker "
"2003 Run-Time-Package (RTP)."

#: qtris/runners/easyrpg.py:403
msgid "Fallback RTP location"
msgstr "Alternativ RTP-plats"

#: qtris/runners/easyrpg.py:404
msgid "Full path to a directory containing a combined RTP."
msgstr "Fullständig sökväg till en katalog som innehåller en kombinerad RTP."

#: qtris/runners/easyrpg.py:517
msgid "No game directory provided"
msgstr "Ingen spelkatalog angiven"

#: qtris/runners/flatpak.py:21
msgid "Runs Flatpak applications"
msgstr "Kör Flatpak-program"

#: qtris/runners/flatpak.py:24
msgid "Flatpak"
msgstr "Flatpak"

#: qtris/runners/flatpak.py:33 qtris/runners/steam.py:37
msgid "Application ID"
msgstr "Program-ID"

#: qtris/runners/flatpak.py:34
msgid "The application's unique three-part identifier (tld.domain.app)."
msgstr "Programmets unika tredelade identifierare (tld.domain.app)."

#: qtris/runners/flatpak.py:39
msgid "Architecture"
msgstr "Arkitektur"

#: qtris/runners/flatpak.py:41
msgid ""
"The architecture to run. See flatpak --supported-arches for architectures "
"supported by the host."
msgstr ""
"Den arkitektur som ska köras. Se flatpak --supported-arches för arkitekturer "
"som stöds av värdsystemet."

#: qtris/runners/flatpak.py:45
msgid "Branch"
msgstr "Gren"

#: qtris/runners/flatpak.py:45
msgid "The branch to use."
msgstr "Den gren som ska användas."

#: qtris/runners/flatpak.py:49
msgid "Install type"
msgstr "Installationstyp"

#: qtris/runners/flatpak.py:50
msgid "Can be system or user."
msgstr "Kan vara system eller användare."

#: qtris/runners/flatpak.py:56
msgid "Args"
msgstr "Argument"

#: qtris/runners/flatpak.py:57
msgid "Arguments to be passed to the application."
msgstr "Argument som ska skickas till programmet."

#: qtris/runners/flatpak.py:62
msgid "Command"
msgstr "Kommando"

#: qtris/runners/flatpak.py:63
msgid ""
"The command to run instead of the one listed in the application metadata."
msgstr ""
"Det kommando som ska köras i stället för det som anges i programmets "
"metadata."

#: qtris/runners/flatpak.py:71
msgid ""
"The directory to run the command in. Note that this must be a directory "
"inside the sandbox."
msgstr ""
"Den katalog som kommandot ska köras i. Observera att detta måste vara en "
"katalog i sandlådan."

#: qtris/runners/flatpak.py:77 qtris/sysoptions.py:409
msgid "Environment variables"
msgstr "Miljövariabler"

#: qtris/runners/flatpak.py:79
msgid ""
"Set an environment variable in the application. This overrides to the "
"Context section from the application metadata."
msgstr ""
"Ställ in en miljövariabel i programmet. Detta åsidosätter avsnittet Context "
"i programmets metadata."

#: qtris/runners/flatpak.py:92
msgid "The Flatpak executable could not be found."
msgstr "Det gick inte att hitta Flatpak-programmet."

#: qtris/runners/flatpak.py:98
msgid ""
"Flatpak installation is not handled by Qtris.\n"
"Install Flatpak with the package provided by your distribution."
msgstr ""
"Installationen av Flatpak hanteras inte av Qtris.\n"
"Installera Flatpak med det paket som tillhandahålls av din distribution."

#: qtris/runners/flatpak.py:140
msgid "No application specified."
msgstr "Inget program angivet."

#: qtris/runners/flatpak.py:144
msgid ""
"Application ID is not specified in correct format.Must be something like: "
"tld.domain.app"
msgstr ""
"Program-ID har fel format. Det ska exempelvis vara: tld.domain.app"

#: qtris/runners/flatpak.py:148
msgid "Application ID field must not contain options or arguments."
msgstr "Fältet Program-ID får inte innehålla alternativ eller argument."

