msgstr "Ta bort standardmarginaler och -avstånd i <body>"

#: qtris/runners/web.py:110
msgid ""
"Sets margin and padding to zero on &lt;html&gt; and &lt;body&gt; elements."
msgstr ""
"Sätter marginal och utfyllnad till noll för elementen &lt;html&gt; och &lt;"
"body&gt;."

